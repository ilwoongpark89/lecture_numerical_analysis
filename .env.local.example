# ── 수치해석 강의 추적 (Supabase) ── SETUP.md 참고. 실제 값은 .env.local 에만 (git 무시).

# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# 교수 /admin 로그인 비밀번호 (교수가 입력, 기억하기 쉬운 값)
NA_ADMIN_PASSWORD=change-me

# DB admin_secret 토큰 (강한 랜덤) — sql/schema.sql 의 __NA_ADMIN_TOKEN__ 치환값과 동일해야 함.
# 서명 세션(HMAC) 키 겸용. `openssl rand -hex 24` 등으로 생성.
NA_ADMIN_TOKEN=replace-with-strong-random-token

# 학생 첫 입장 반 인증코드 (수업에서 안내)
NEXT_PUBLIC_NA_CLASS_PASSWORD=NA2026

# (선택) 설정 시 admin 이 service_role 로 직접 read → anon RPC 공개 attack surface 제거 가능
# SUPABASE_SERVICE_ROLE_KEY=
